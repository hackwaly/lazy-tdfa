    ),
    (
      "((a*?b*?))*(a)",
      "x!baaa",
      Some([Some((2, 5)), Some((3, 4)), Some((3, 4)), Some((4, 5))]),
    ),
    ("((a*?b*?))*(a)", "😀b", None),
    ("((a*?b*?))*(a)", "😀😀b", None),
    ("((a*?b*?))*(a)", "b😀😀😀", None),
    ("^(😀?)*b$", "", None),
    ("^(😀?)*b$", "a", None),
    ("^(😀?)*b$", "aa", None),
    ("^(😀?)*b$", "aaa", None),
    ("^(😀?)*b$", "b", Some([Some((0, 1)), Some((0, 0))])),
    ("^(😀?)*b$", "ab", None),
    ("^(😀?)*b$", "aab", None),
    ("^(😀?)*b$", "aaab", None),
    ("^(😀?)*b$", "baaa", None),
    ("^(😀?)*b$", "baaaa", None),
    ("^(😀?)*b$", "aab!", None),
    ("^(😀?)*b$", "aa!", None),
    ("^(😀?)*b$", "baaa!", None),
    ("^(😀?)*b$", "x!baaa", None),
    ("^(😀?)*b$", "😀b", Some([Some((0, 3)), Some((0, 2))])),
    ("^(😀?)*b$", "😀😀b", Some([Some((0, 5)), Some((2, 4))])),
    ("^(😀?)*b$", "b😀😀😀", None),
    ("^((😀*?b*?))*(😀)", "", None),
    ("^((😀*?b*?))*(😀)", "a", None),
    ("^((😀*?b*?))*(😀)", "aa", None),
    ("^((😀*?b*?))*(😀)", "aaa", None),
    ("^((😀*?b*?))*(😀)", "b", None),
    ("^((😀*?b*?))*(😀)", "ab", None),
    ("^((😀*?b*?))*(😀)", "aab", None),
    ("^((😀*?b*?))*(😀)", "aaab", None),
    ("^((😀*?b*?))*(😀)", "baaa", None),
    ("^((😀*?b*?))*(😀)", "baaaa", None),
    ("^((😀*?b*?))*(😀)", "aab!", None),
    ("^((😀*?b*?))*(😀)", "aa!", None),
    ("^((😀*?b*?))*(😀)", "baaa!", None),
    ("^((😀*?b*?))*(😀)", "x!baaa", None),
    (
      "^((😀*?b*?))*(😀)",
      "😀b",
      Some([Some((0, 2)), Some((0, 0)), Some((0, 0)), Some((0, 2))]),
    ),
    (
      "^((😀*?b*?))*(😀)",
      "😀😀b",
      Some([Some((0, 2)), Some((0, 0)), Some((0, 0)), Some((0, 2))]),
    ),
    (
      "^((😀*?b*?))*(😀)",
      "b😀😀😀",
      Some([Some((0, 5)), Some((1, 3)), Some((1, 3)), Some((3, 5))]),
    ),
  ]
  for (pattern, input, expected) in cases {
    let regex = @regex.Regex::unsafe_from_string(pattern)
    for _ in 0..<2 {
      match (regex.execute(input), expected) {
        (None, None) => ()
        (Some(result), Some(groups)) => {
          for index, span in groups {
            let actual = result
              .group(index)
              .map(group => {
                (group.start_offset(), group.start_offset() + group.length())
              })
            if actual != span {
              fail("capture mismatch: \{pattern} on \{input}, group \{index}")
            }
          }
          assert_eq(result.group(groups.length()), None)
        }
        _ => fail("match mismatch: \{pattern} on \{input}")
      }
    }
  }
}
